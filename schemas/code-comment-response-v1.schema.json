{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sdougbrown/writetighter/schemas/code-comment-response-v1.schema.json",
  "title": "Code Comment Response v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "comment_id": {"type": "string"},
          "action": {"type": "string", "enum": ["rewrite", "clarification"]},
          "principle_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["{{PRINCIPLE_IDS}}"]}
          },
          "reason": {"type": "string", "minLength": 1},
          "replacement": {"type": ["string", "null"]},
          "question": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["comment_id", "action", "principle_ids", "reason", "replacement", "question", "confidence"]
      }
    }
  },
  "required": ["findings"]
}
