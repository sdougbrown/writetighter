{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sdougbrown/writetighter/schemas/profile-dictionary-v1.schema.json",
  "title": "Profile Dictionary v1",
  "description": "Schema for WriteTighter profile dictionary.json, format_version 1",
  "type": "object",
  "required": ["format_version", "entries"],
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "status"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "parts_of_speech": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["preferred", "allowed", "discouraged", "observed"]
          },
          "alternatives": {
            "type": "array",
            "items": { "type": "string" }
          },
          "canonical_case": { "type": ["string", "null"] },
          "reason": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
